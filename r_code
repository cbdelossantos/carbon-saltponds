#### STOCK CALCULATION ####

# Data: You must have a data.frame with 3 columns:
## core_id: each core must have a unique identifier
## depth_corr: middle depth of the sample, after correcting for compaction
## oc_concentration: carbon concentration in g cm3 (oc fraction * dry bulk density)
## Assumptions:
## dry bulk density values have been corrected to account for compaction!
## there are NO missing values in any of the columns

# calculate organic carbon density (g OC cm-3)
data.dep$oc_concentration <- with(data.dep,dry_bulk_density*percentage_organic_carbon/100)
data <- data.dep[,c("core_id","depth_middle","oc_concentration")]

# Stock estimation parameters - change according to your use-case
## Start of stock (cm)
min_depth <- 0

## End of stock (cm)
max_depth <- 30

## How to extrapolate if your data does not reach the end of stock
## 1 - stops stock calculation at last recorded depth
## 2 - takes last recorded value and extends it to the end
extrapolation_rule <- 2 


# Carbon stocks. If depths are in cm and concentrations in g OC cm3, results will
# be in g OC cm2
data.sto <- data %>%
  # group by core 
  dplyr::group_by(core_id) %>%
  # separate the data of each core
  tidyr::nest() %>%
  # map
  dplyr::mutate(
    oc_stock = purrr::map_dbl(
      data,
      function(df) {
        MESS::auc(
          x = df$depth_middle,
          y = df$oc_concentration,
          from = min_depth,
          to = max_depth,
          type = "linear",
          rule = extrapolation_rule
        )
      }
    )
  )

data.sto # g OC cm2
data.sto$oc_stock <- data.sto$oc_stock*100 # Mg OC ha-1
data.sto$data <- NULL
data.sto

# add info
data.inf  <- unique(data.dep[,c("core_id","tank_code")])
data.sto  <- merge(data.sto,data.inf,by=c("core_id"))
data.sto

# clean
rm(data.inf,extrapolation_rule,data,max_depth,min_depth)

