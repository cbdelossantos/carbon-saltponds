#### RATE CALCULATION ####

# calculate sediment accumulation rate (mm yr-1) from om-rich layer depth and pond age
data.rat$sar <- 10*data.rat$om_layer/data.rat$age 

# prepare data to obtain mean organic carbon density for each core, at the depth of 49 years
data.den <- data.dep[,c("tank_code","core_id","depth_min","depth_max","oc_concentration")]
data.den <- merge(data.den,data.rat[,c("core_id","depth49")],by="core_id")
data.den$select <- ifelse(data.den$depth_max<=data.den$depth49,"yes","no")
data.den <- data.den[is.na(data.den$oc_concentration)==F & data.den$select=="yes",]

# calculate weighted mean of organic carbon density considering the layer thickness that represents each measurement
n.core <- unique(data.den$core_id)
TABLE.DEN <- data.frame()
DATA.DEN  <- data.frame()

for(i in 1:length(n.core)){
  data <- data.den[data.den$core_id==n.core[i],]
  for(j in 1:nrow(data)){
    if(j<nrow(data)){
      data$thickness[j] <- data$depth_min[j+1]-data$depth_min[j]
      }else{
        data$thickness[j] <- data$depth_max[j]-data$depth_min[j]
      }
    }
  table <- data.frame(core_id=n.core[i],
                      n=length(data$oc_concentration),
                      oc_conc_mean=weighted.mean(data$oc_concentration,data$thickness),
                      oc_conc_sd=wtd.sd(data$oc_concentration,data$thickness))
  table$oc_conc_se <- table$oc_conc_sd/sqrt(table$n)
  TABLE.DEN <- rbind(TABLE.DEN,table)
  DATA.DEN  <- rbind(DATA.DEN,data)
}
data.den  <- DATA.DEN
table.den <- TABLE.DEN

# add averages to data.rat
data.rat <- merge(data.rat,table.den)

# calculate organic carbon burial rates
data.rat$oc_burial <- 10^3*data.rat$sar*data.rat$oc_conc_mean

# view
data.rat

# clean
rm(data,table,i,j,n.core,DATA.DEN,TABLE.DEN,table.den)

